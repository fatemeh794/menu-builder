# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ============================================================

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=config.settings.dev

# --- Database (Postgres) ---
POSTGRES_DB=restaurant_menu
POSTGRES_USER=restaurant_menu
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- CORS / Frontend ---
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080
FRONTEND_BASE_URL=http://localhost:4200

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MIN=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Zarinpal ---
# Sandbox merchant id works out of the box for testing without a real account.
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=True
ZARINPAL_CALLBACK_URL=http://localhost:8000/api/v1/payments/callback/
